---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, allEntries: blogEntries },
  }));
}

const { entry, allEntries = [] } = Astro.props;
const { Content } = await render(entry);

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const siteOrigin = Astro.site
  ? Astro.site.toString().replace(/\/?$/, "")
  : "https://mayurdb-blogs.in";
const canonicalURL = new URL(
  `${baseUrl}blog/${entry.id}/`,
  siteOrigin,
).toString();
const homeURL = new URL(baseUrl, siteOrigin).toString();

const authorName = entry.data.author || "Mayur Bakale";
const tags: string[] = entry.data.tags || [];
const rawBody = entry.body || "";
const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 220));

const seoTitle = `${entry.data.title} | ${authorName}`;
const seoDescription =
  entry.data.description ||
  `${entry.data.title} — Enterprise architecture blueprint and implementation guide by ${authorName}.`;

// Compute related articles ranked by shared tags and recency for internal linking
const relatedPosts = allEntries
  .filter((other) => other.id !== entry.id)
  .map((other) => {
    const sharedTags = (other.data.tags || []).filter((t: string) =>
      tags.includes(t),
    ).length;
    return { post: other, sharedTags };
  })
  .sort((a, b) => {
    if (b.sharedTags !== a.sharedTags) return b.sharedTags - a.sharedTags;
    return (
      b.post.data.publishDate.getTime() - a.post.data.publishDate.getTime()
    );
  })
  .slice(0, 3)
  .map((item) => item.post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": ["TechArticle", "BlogPosting"],
  headline: entry.data.title,
  description: seoDescription,
  image: new URL(`${baseUrl}og-cover.svg`, siteOrigin).toString(),
  datePublished: entry.data.publishDate.toISOString(),
  dateModified: (
    entry.data.updatedDate || entry.data.publishDate
  ).toISOString(),
  wordCount: wordCount,
  proficiencyLevel: entry.data.complexity,
  inLanguage: "en-US",
  keywords: tags.join(", "),
  articleSection: "System Architecture",
  author: {
    "@type": "Person",
    name: authorName,
    url: "https://github.com/mayurbakale-labs",
  },
  publisher: {
    "@type": "Person",
    name: authorName,
    url: homeURL,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Architecture Articles",
      item: homeURL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: entry.data.title,
      item: canonicalURL,
    },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalURL={canonicalURL}
  type="article"
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  author={authorName}
  tags={tags}
  complexity={entry.data.complexity}
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <Header />

  <main class="max-w-3xl mx-auto px-6 py-12 w-full flex-grow">
    {/* Crawl-friendly Breadcrumb Navigation */}
    <nav aria-label="Breadcrumb" class="mb-6 text-xs font-mono text-slate-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a
            href={baseUrl}
            class="hover:text-blue-600 underline underline-offset-4"
          >
            Home
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-700 truncate max-w-md" aria-current="page">
          {entry.data.title}
        </li>
      </ol>
    </nav>

    {/* Article Header with Metadata */}
    <header class="mb-12 border-b border-slate-200 pb-8">
      <div
        class="flex flex-wrap items-center gap-3 text-sm text-slate-500 font-mono mb-4"
      >
        <time datetime={entry.data.publishDate.toISOString()}>
          {
            entry.data.publishDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })
          }
        </time>
        <span>•</span>
        <span class="px-2 py-0.5 bg-slate-200 rounded-md text-slate-800">
          {entry.data.complexity}
        </span>
        <span>•</span>
        <span>{readingTimeMinutes} min read</span>
        <span>•</span>
        <span
          >By <strong class="text-slate-700 font-semibold">{authorName}</strong
          ></span
        >
      </div>

      <h1
        class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 mb-6 leading-tight"
      >
        {entry.data.title}
      </h1>

      {
        entry.data.description && (
          <p class="text-xl text-slate-600 leading-relaxed mb-6">
            {entry.data.description}
          </p>
        )
      }

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2" aria-label="Article topics">
            {tags.map((tag) => (
              <span class="px-2.5 py-1 rounded text-xs font-mono bg-slate-100 text-slate-700 border border-slate-200">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    {/* Typography-focused Markdown/MDX rendering area */}
    <article
      class="prose prose-slate prose-lg md:prose-xl max-w-none
                    prose-headings:font-semibold prose-headings:tracking-tight
                    prose-a:text-blue-600 prose-a:underline-offset-4 hover:prose-a:text-blue-500
                    prose-code:before:content-none prose-code:after:content-none
                    prose-pre:border prose-pre:border-slate-700"
    >
      <Content />
    </article>

    {/* Related Architecture Blueprints for Internal Linking & Crawl Depth */}
    {
      relatedPosts.length > 0 && (
        <aside
          aria-labelledby="related-articles-heading"
          class="mt-16 pt-10 border-t border-slate-200"
        >
          <h2
            id="related-articles-heading"
            class="text-2xl font-bold tracking-tight text-slate-900 mb-6"
          >
            Related Architecture Blueprints
          </h2>
          <div class="grid gap-6">
            {relatedPosts.map((related) => (
              <div class="p-5 rounded-lg border border-slate-200 bg-white hover:border-blue-300 transition">
                <div class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-2">
                  <time datetime={related.data.publishDate.toISOString()}>
                    {related.data.publishDate.toISOString().split("T")[0]}
                  </time>
                  <span>•</span>
                  <span>{related.data.complexity}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">
                  <a
                    href={`${baseUrl}blog/${related.id}/`}
                    class="hover:text-blue-600 transition"
                  >
                    {related.data.title}
                  </a>
                </h3>
                {related.data.description && (
                  <p class="text-sm text-slate-600 line-clamp-2">
                    {related.data.description}
                  </p>
                )}
              </div>
            ))}
          </div>
        </aside>
      )
    }
  </main>

  {
    /* Use is:inline so Astro ignores it and lets the browser fetch the CDN directly */
  }
  <script type="module" is:inline>
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

    mermaid.initialize({
      startOnLoad: false,
      theme: "base",
      themeVariables: {
        fontFamily:
          "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        primaryColor: "#f1f5f9",
        primaryBorderColor: "#cbd5e1",
        primaryTextColor: "#0f172a",
        lineColor: "#475569",
      },
    });

    const diagrams = document.querySelectorAll(
      'pre[data-language="mermaid"], pre.language-mermaid',
    );

    diagrams.forEach(async (diagram, index) => {
      try {
        const content = diagram.textContent || "";
        const id = `mermaid-svg-${index}`;

        const { svg } = await mermaid.render(id, content);

        const container = document.createElement("div");
        container.innerHTML = svg;
        container.className =
          "flex justify-center my-12 w-full overflow-x-auto";

        diagram.replaceWith(container);
      } catch (error) {
        console.error("Mermaid failed to render diagram:", error);
      }
    });
  </script>
</BaseLayout>
